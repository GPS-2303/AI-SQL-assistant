DB_HOST=localhost
DB_PORT=3306
DB_USER=ai_sql_readonly
DB_PASSWORD=change_me_readonly
DB_NAME=ai_sql_dev

# Optional: separate user for INSERT/UPDATE/DELETE/DDL (writes).
# If not set, the assistant reuses DB_USER/DB_PASSWORD for writes.
DB_WRITE_USER=ai_sql_writer
DB_WRITE_PASSWORD=change_me_writer

# Safety controls for write statements.
MAX_WRITE_ROWS=100
ALLOW_FULL_TABLE_WRITE=false

# Audit controls.
AUDIT_LOG_ENABLED=true
AUDIT_ACTOR=fastapi

# Optional API authentication for FastAPI endpoints (/query, /execute, /audit).
# Leave empty to disable API-key checks in local development.
API_KEY=

# Comma-separated browser origins allowed by the FastAPI CORS middleware.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
